{
  "$schema": "./node_modules/fallow/schema.json",

  // Package exports and bins are discovered automatically. These additional
  // roots cover repository-only executables that are not published.
  "entry": [
    "benchmarks/agent-protocol.ts",
    "src/inspection/analysis-process-entry.ts",
    "src/inspection/performance-profile-disabled.ts",
    "taze.config.ts",
    "tests/build-output-smoke.ts",
    "tests/package-output-smoke.ts"
  ],

  // These tools are invoked through Vite+ or repository task configuration,
  // which Fallow cannot discover as dependency usage. Remove an exception as
  // soon as a source-level import makes the dependency visible.
  "ignoreDependencies": [
    "@arethetypeswrong/core",
    "@effect/tsgo",
    "@typescript/typescript6",
    "publint",
    "unplugin-unused"
  ],

  "rules": {
    "private-type-leaks": "error"
  }
}
