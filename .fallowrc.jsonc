{
  "$schema": "./node_modules/fallow/schema.json",

  // Package exports and bins are discovered automatically. These additional
  // roots cover build adapters and repository-only executables.
  "entry": [
    "tests/effect-diagnostics.ts",
    "tests/benchmark-package-smoke.ts",
    "tests/fixtures/codex-app-server.ts",
    "benchmarks/codex-discovery/run.ts",
    "benchmarks/codex-discovery/capture.ts",
    "benchmarks/codex-discovery/replay.ts",
    "src/inspection/performance-profile-disabled.ts",
    "taze.config.ts",
    "tests/build-output-smoke.ts",
    "tests/package-output-smoke.ts",
  ],

  // Fallow cannot detect these tools in Vite+ tasks. Remove exceptions when
  // source imports make the dependencies discoverable.
  "ignoreDependencies": [
    // Used only by benchmark executables, not the published CLI.
    "gpt-tokenizer",
  ],

  // Score runtime health separately; the other checks also cover tests and benchmarks.
  "health": {
    "ignore": ["benchmarks/**", "tests/**", "vite.config.ts", "taze.config.ts"],
  },

  "rules": {
    "private-type-leaks": "error",
  },
}
