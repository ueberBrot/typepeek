{
  "name": "typepeek",
  "version": "0.3.0",
  "description": "Describe the TypeScript-visible Public Interface of Inspectable Modules.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/typepeek.git"
  },
  "bin": {
    "typepeek": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/inspection-api.js",
    "assets/typepeek-logo.svg",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#typepeek/inspection": "./src/inspection/index.ts",
    "#typepeek/*": "./src/*.ts"
  },
  "exports": {},
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && vp fmt CHANGELOG.md package.json",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@stricli/core": "^1.3.0",
    "@typescript/typescript6": "6.0.2",
    "effect": "4.0.0-rc.112",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^24.13.6",
    "fallow": "^3.28.0",
    "gpt-tokenizer": "4.0.0",
    "publint": "^0.3.24",
    "taze": "^21.1.0",
    "typescript": "7.0.2",
    "unplugin-unused": "^0.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@12.6.0"
}
