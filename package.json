{
  "name": "typepeek",
  "version": "0.6.0",
  "description": "Describe the TypeScript-visible Public Interface of Inspectable Modules.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/typepeek.git"
  },
  "bin": {
    "typepeek": "./dist/launcher.js"
  },
  "workspaces": [
    ".",
    "packages/*",
    "tooling/*"
  ],
  "files": [
    "dist/**/*.js",
    "!dist/inspection-api.js",
    "assets/typepeek-logo.svg",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#typepeek/inspection": "./src/inspection/index.ts",
    "#typepeek/*": "./src/*.ts"
  },
  "exports": {},
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && vp install --lockfile-only --ignore-scripts && vp fmt CHANGELOG.md package.json packages",
    "prepare": "effect-tsgo patch --no-typescript --oxlint && vp config --no-agent"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "effect": "4.1.2",
    "semver": "7.8.6",
    "tsrs": "0.20.1-ts7.1.0-beta"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@tanstack/ai": "1.0.1",
    "@tanstack/ai-codex": "1.0.0",
    "@tanstack/ai-harness": "0.1.1",
    "@tanstack/ai-persistence": "1.0.1",
    "@tanstack/ai-sandbox": "1.0.0",
    "@tanstack/ai-sandbox-docker": "1.0.0",
    "@types/bun": "1.4.4",
    "@types/node": "^24.19.2",
    "@types/semver": "7.8.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "fallow": "^3.38.1",
    "gpt-tokenizer": "4.1.0",
    "publint": "^0.3.25",
    "taze": "^21.3.0",
    "ultracite": "8.1.1",
    "unplugin-unused": "^0.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "typepeek-darwin-arm64": "workspace:*",
    "typepeek-darwin-x64": "workspace:*",
    "typepeek-linux-arm64-gnu": "workspace:*",
    "typepeek-linux-arm64-musl": "workspace:*",
    "typepeek-linux-x64-gnu": "workspace:*",
    "typepeek-linux-x64-musl": "workspace:*",
    "typepeek-win32-x64": "workspace:*"
  },
  "overrides": {
    "@oxlint/plugins": "1.90.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-preview": "5.1.0",
    "@vitest/mocker": "5.1.0",
    "@vitest/pretty-format": "5.1.0",
    "@vitest/snapshot": "5.1.0",
    "@vitest/spy": "5.1.0",
    "@vitest/utils": "5.1.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
