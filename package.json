{
  "name": "typepeek",
  "version": "0.4.2",
  "description": "Describe the TypeScript-visible Public Interface of Inspectable Modules.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/typepeek.git"
  },
  "bin": {
    "typepeek": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/inspection-api.js",
    "assets/typepeek-logo.svg",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#typepeek/inspection": "./src/inspection/index.ts",
    "#typepeek/*": "./src/*.ts"
  },
  "exports": {},
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && vp fmt CHANGELOG.md package.json",
    "prepare": "effect-tsgo patch --no-typescript --oxlint && vp config --no-agent"
  },
  "dependencies": {
    "@stricli/core": "^1.3.0",
    "@typescript/typescript6": "6.0.2",
    "effect": "4.0.7",
    "execa": "^10.2.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.7",
    "@types/node": "^24.19.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fallow": "^3.37.0",
    "gpt-tokenizer": "4.1.0",
    "publint": "^0.3.25",
    "taze": "^21.3.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "unplugin-unused": "^0.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@12.16.1"
}
