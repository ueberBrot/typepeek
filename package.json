{
  "name": "typepeek",
  "version": "0.0.0",
  "private": true,
  "description": "Describe the TypeScript-visible Public Interface of Inspectable Modules.",
  "bin": {
    "typepeek": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#typepeek/inspection": "./src/inspection-api.ts",
    "#typepeek/*": "./src/*.ts"
  },
  "exports": {
    "./inspection": {
      "types": "./dist/inspection-api.d.ts",
      "import": "./dist/inspection-api.js"
    }
  },
  "scripts": {
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@stricli/core": "^1.3.0",
    "@typescript/typescript6": "6.0.2",
    "effect": "4.0.0-rc.110",
    "execa": "^10.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@types/node": "^24.13.3",
    "fallow": "^3.10.0",
    "publint": "^0.3.22",
    "taze": "^19.16.0",
    "typescript": "7.0.2",
    "unplugin-unused": "^0.6.0",
    "vite-plus": "^0.2.6"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.20.0"
}
