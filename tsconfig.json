{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Array"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-bun/BunChildProcessSpawner#layer",
          "@effect/platform-bun/BunFileSystem#layer",
          "@effect/platform-bun/BunPath#layer",
          "@effect/platform-bun/BunRuntime#runMain",
          "@effect/platform-node-shared/NodeChildProcessSpawner#layer",
          "@effect/platform-node-shared/NodeSink#fromWritable",
          "@effect/platform-bun/BunSink#fromWritable",
          "@effect/platform-bun/BunStdio#layer",
          "@effect/platform-bun/BunTerminal#layer",
          "@effect/vitest#effect",
          "@effect/vitest#live",
          "@effect/platform-node-shared/NodeCrypto#layerDigest",
          "@effect/platform-node-shared/NodeCrypto#layerSecureRandom",
          "effect/FileSystem",
          "effect/Path",
          "effect/crypto/Digest",
          "effect/crypto/SecureRandom",
          "effect/ByteSize",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/cli",
          "effect/process"
        ]
      }
    ]
  },
  "include": [
    "benchmarks/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "taze.config.ts",
    "vite.config.ts"
  ]
}
